# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Downloadable native builds and other generated outputs.
/generated-artifacts/

# Regenerable native compiler output is not needed by hosted services.
**/node_modules/**/android/build/
**/node_modules/**/android/.cxx/
**/node_modules/**/android/.gradle/
**/node_modules/**/ios/build/
/artifacts/social-chat/android/app/build/
/artifacts/social-chat/android/app/.cxx/
/artifacts/social-chat/android/build/
/artifacts/social-chat/android/.gradle/
