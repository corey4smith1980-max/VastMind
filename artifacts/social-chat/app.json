{
  "expo": {
    "name": "VastMind",
    "slug": "social-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gather",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.vastmind.social",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/vastmind-monochrome.png",
        "backgroundColor": "#01010E"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#010102",
          "image": "./assets/images/vastmind-splash.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#010102",
            "image": "./assets/images/vastmind-splash.png"
          }
        }
      ],
      "expo-video",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow VastMind to use the camera when you record a clip or story.",
          "microphonePermission": "Allow VastMind to record sound with your video clips.",
          "photosPermission": "Choose videos from your library to create VastMind clips and stories."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
