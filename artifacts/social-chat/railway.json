{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "artifacts/social-chat/Dockerfile",
    "watchPatterns": [
      "artifacts/social-chat/**",
      "lib/api-client-react/**",
      "lib/mail-crypto/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      ".npmrc",
      ".dockerignore"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @workspace/social-chat run serve",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
