{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "artifacts/neura-connect/Dockerfile",
    "watchPatterns": [
      "artifacts/neura-connect/**",
      "lib/api-client-react/**",
      "lib/api-zod/**",
      "lib/mail-crypto/**",
      "lib/vastmind-token/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.json",
      "tsconfig.base.json",
      ".npmrc",
      ".dockerignore"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @workspace/neura-connect run start",
    "healthcheckPath": "/healthz/",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
