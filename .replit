modules = ["nodejs-24", "python-base-3.13", "java-graalvm22.3", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["jdk17"]

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 22088
externalPort = 3000

[userenv]

[userenv.production]
VASTMIND_AUTH_URL = "https://social-connect-hub--corey4smith1980.replit.app"

[userenv.shared]
CLERK_TELEMETRY_DISABLED = "1"
